{
  "name": "plenty",
  "version": "0.1.0",
  "private": true,
  "description": "Plenty WooCommerce theme",
  "scripts": {
    "dev": "tailwindcss -i ./src/css/app.css -o ./dist/app.css --watch",
    "build": "tailwindcss -i ./src/css/app.css -o ./dist/app.css --minify",
    "deploy": "npm run build && node bin/deploy.mjs",
    "pull": "node bin/pull.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
